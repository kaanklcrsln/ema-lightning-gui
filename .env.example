# Raven'ın kullandığı API anahtarı.
# Bu dosyayı ".env" adıyla kopyala ve anahtarını yaz. ".env" GitHub'a gönderilmez.

# Google AI Studio anahtarı: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# İsteğe bağlı: modeli sabitle, örneğin gemini-3.8-flash. Boş bırakırsan en yeni Gemini Flash otomatik seçilir.
# Model yoğunsa o soru için bir önceki Flash denenir.
GEMINI_MODEL=
